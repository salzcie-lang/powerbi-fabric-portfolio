table _Measures
	lineageTag: b582f3ce-9fd6-5634-b599-dc61df992f28

	measure 'As Of Date' = EOMONTH ( CALCULATE ( MAX ( 'Rent Payments'[Due Date] ), REMOVEFILTERS () ), 0 )
		formatString: dd mmm yyyy
		displayFolder: 0. Base
		lineageTag: 1fbe3912-fd5b-5ffc-ae89-ed8ccb4326c4

	/// Last date in the selection, capped at the as-of date. Occupancy is measured on this date.
	measure 'Snapshot Date' = MIN ( MAX ( 'Date'[Date] ), [As Of Date] )
		formatString: dd mmm yyyy
		displayFolder: 0. Base
		lineageTag: 4ff47f26-e08e-5ccb-a452-9231ce224e68

	measure Properties = COUNTROWS ( 'Properties' )
		formatString: #,##0
		displayFolder: 1. Portfolio
		lineageTag: aab24cb1-ad6b-552a-9438-be7e2c952a28

	measure Units = COUNTROWS ( Units )
		formatString: #,##0
		displayFolder: 1. Portfolio
		lineageTag: 71241bb4-537f-5e10-874d-a1c39c916762

	measure 'Portfolio Value' = SUM ( 'Properties'[Current Value] )
		formatString: $#,##0
		displayFolder: 1. Portfolio
		lineageTag: 43d3b528-036c-50d1-9a16-6a49e40e1862

	measure 'Purchase Price' = SUM ( 'Properties'[Purchase Price] )
		formatString: $#,##0
		displayFolder: 1. Portfolio
		lineageTag: ed31dd97-1a18-56c4-a06e-3749d2721a98

	measure 'Appreciation %' = DIVIDE ( [Portfolio Value] - [Purchase Price], [Purchase Price] )
		formatString: 0.0%
		displayFolder: 1. Portfolio
		lineageTag: f9ed5bd8-07d7-532f-bdb0-8f4b900351d3

	measure 'Occupied Units' =
			VAR _d = [Snapshot Date]
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) <= [As Of Date],
			        CALCULATE ( DISTINCTCOUNT ( Leases[UnitKey] ), Leases[Start Date] <= _d, Leases[End Date] >= _d )
			    )
		formatString: #,##0
		displayFolder: 2. Occupancy
		lineageTag: 46df2997-70db-57ea-b03b-11ccaf5779d6

	measure 'Occupied Units PY' =
			VAR _d = EDATE ( [Snapshot Date], -12 )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) <= [As Of Date],
			        CALCULATE ( DISTINCTCOUNT ( Leases[UnitKey] ), Leases[Start Date] <= _d, Leases[End Date] >= _d )
			    )
		formatString: #,##0
		displayFolder: 2. Occupancy
		lineageTag: b560aeb8-dd2c-5b48-b75e-003f768401aa

	measure 'Occupancy %' = DIVIDE ( [Occupied Units], [Units] )
		formatString: 0.0%
		displayFolder: 2. Occupancy
		lineageTag: 6bfd7b96-0673-5795-9c8d-e3353914b019

	measure 'Occupancy % PY' = DIVIDE ( [Occupied Units PY], [Units] )
		formatString: 0.0%
		displayFolder: 2. Occupancy
		lineageTag: eebf97b5-4859-5591-896b-fd591660ad11

	measure 'Vacant Units' = IF ( NOT ISBLANK ( [Occupied Units] ), [Units] - [Occupied Units] )
		formatString: #,##0
		displayFolder: 2. Occupancy
		lineageTag: 0cfe7bac-2512-59f7-95ce-36c0aa28ee16

	/// Monthly contracted rent of leases active on the snapshot date.
	measure 'Rent Roll' =
			VAR _d = [Snapshot Date]
			RETURN
			    CALCULATE ( SUM ( Leases[Monthly Rent] ), Leases[Start Date] <= _d, Leases[End Date] >= _d )
		formatString: $#,##0
		displayFolder: 2. Occupancy
		lineageTag: 73741402-40d2-5def-8c75-9571939cc4a0

	measure 'Avg Rent per Unit' = DIVIDE ( [Rent Roll], [Occupied Units] )
		formatString: $#,##0
		displayFolder: 2. Occupancy
		lineageTag: e3958921-6c30-5728-85f7-a34a3d056f07

	/// Active leases that end within 90 days of the as-of date.
	measure 'Expiring Leases' =
			VAR _a = [As Of Date]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Leases ),
			        KEEPFILTERS ( Leases[Start Date] <= _a ),
			        KEEPFILTERS ( Leases[End Date] >= _a && Leases[End Date] <= _a + 90 )
			    )
		formatString: #,##0
		displayFolder: 2. Occupancy
		lineageTag: bc569e65-1aed-542c-b5a9-6008b07d0057

	measure 'Expiring Rent' =
			VAR _a = [As Of Date]
			RETURN
			    CALCULATE (
			        SUM ( Leases[Monthly Rent] ),
			        KEEPFILTERS ( Leases[Start Date] <= _a ),
			        KEEPFILTERS ( Leases[End Date] >= _a && Leases[End Date] <= _a + 90 )
			    )
		formatString: $#,##0
		displayFolder: 2. Occupancy
		lineageTag: 0bb33908-ad73-59e9-9888-54015d089c53

	measure 'Rent Due' = SUM ( 'Rent Payments'[Amount Due] )
		formatString: $#,##0
		displayFolder: 3. Collections
		lineageTag: 793c7dc7-0902-5851-b0cb-58ffa2c99b94

	measure 'Rent Collected' = SUM ( 'Rent Payments'[Amount Paid] )
		formatString: $#,##0
		displayFolder: 3. Collections
		lineageTag: e3a81e19-0391-5b90-a800-173a7186143c

	measure 'Outstanding Rent' = [Rent Due] - [Rent Collected]
		formatString: $#,##0
		displayFolder: 3. Collections
		lineageTag: 86920d2d-0d27-5eb4-bc9c-97a1e289a0f0

	measure 'Collection Rate' = DIVIDE ( [Rent Collected], [Rent Due] )
		formatString: 0.0%
		displayFolder: 3. Collections
		lineageTag: f3353fc2-9a04-5976-ba4f-54df9a28482f

	measure Payments = COUNTROWS ( 'Rent Payments' )
		formatString: #,##0
		displayFolder: 3. Collections
		lineageTag: e7ea7e06-3f78-57a3-b2bf-19455753064a

	measure 'Operating Expenses Total' = SUM ( 'Operating Expenses'[Amount] )
		formatString: $#,##0
		displayFolder: 4. NOI
		lineageTag: 3f5fb286-3d82-56eb-bd3d-9b0c0d444869

	/// Net operating income: rent collected less operating expenses.
	measure NOI = [Rent Collected] - [Operating Expenses Total]
		formatString: $#,##0
		displayFolder: 4. NOI
		lineageTag: eb629d1b-bdae-54b5-bec1-2c08c460bd97

	measure 'NOI Margin' = DIVIDE ( [NOI], [Rent Collected] )
		formatString: 0.0%
		displayFolder: 4. NOI
		lineageTag: e63a4fad-a815-5813-a55e-0759c67ccfc2

	measure Requests = COUNTROWS ( 'Maintenance Requests' )
		formatString: #,##0
		displayFolder: 5. Maintenance
		lineageTag: e52712e3-dd63-5dd7-a2d3-a909330780fe

	measure 'Open Requests' = CALCULATE ( COUNTROWS ( 'Maintenance Requests' ), 'Maintenance Requests'[Status] = "Open" ) + 0
		formatString: #,##0
		displayFolder: 5. Maintenance
		lineageTag: dcd743ea-7b55-5a3c-a6ac-756875b15f9e

	measure 'Maintenance Cost' = SUM ( 'Maintenance Requests'[Cost] )
		formatString: $#,##0
		displayFolder: 5. Maintenance
		lineageTag: 7399b0db-b600-5666-b5b5-93cdc704f6fe

	measure 'Avg Days to Complete' =
			AVERAGEX (
			    FILTER ( 'Maintenance Requests', NOT ISBLANK ( 'Maintenance Requests'[Completed Date] ) ),
			    DATEDIFF ( 'Maintenance Requests'[Opened Date], 'Maintenance Requests'[Completed Date], DAY )
			)
		formatString: 0.0
		displayFolder: 5. Maintenance
		lineageTag: 150df89b-43cb-5514-bbbb-19520fe7952b

	measure 'Occupancy % Label' =
			VAR _d = ( [Occupancy %] - [Occupancy % PY] ) * 100
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs PY"
		displayFolder: 8. Labels
		lineageTag: 976a51fc-66e3-59aa-b64d-94d5e4ee4246

	measure 'Occupancy % Color' =
			VAR _d = ( [Occupancy %] - [Occupancy % PY] ) * 100
			RETURN
			    IF ( _d >= 0, "#3E9B6E", "#D9735B" )
		displayFolder: 9. Formatting
		lineageTag: 8512f5b8-5aec-58a2-ba7b-6ba08cff3159

	measure 'Rent Collected PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [Rent Collected],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: $#,##0
		displayFolder: 3. Collections
		lineageTag: c3234add-4405-5ce3-b616-3a5f4c4741c8

	measure 'Rent Collected Label' =
			VAR _d = DIVIDE ( [Rent Collected] - [Rent Collected PY], [Rent Collected PY] )
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY"
		displayFolder: 8. Labels
		lineageTag: b7651d86-81a3-5908-9ad8-3306a029d4a2

	measure 'Rent Collected Color' =
			VAR _d = DIVIDE ( [Rent Collected] - [Rent Collected PY], [Rent Collected PY] )
			RETURN
			    IF ( _d >= 0, "#3E9B6E", "#D9735B" )
		displayFolder: 9. Formatting
		lineageTag: fc611968-f929-5875-9d10-af94c96767d9

	measure 'Collection Rate PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [Collection Rate],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: 0.0%
		displayFolder: 3. Collections
		lineageTag: 9010c200-c909-5cf8-b0b5-81c8f1cafacc

	measure 'Collection Rate Label' =
			VAR _d = ( [Collection Rate] - [Collection Rate PY] ) * 100
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs PY"
		displayFolder: 8. Labels
		lineageTag: d94bec1f-ae87-50ff-bfc8-298931c9d79c

	measure 'Collection Rate Color' =
			VAR _d = ( [Collection Rate] - [Collection Rate PY] ) * 100
			RETURN
			    IF ( _d >= 0, "#3E9B6E", "#D9735B" )
		displayFolder: 9. Formatting
		lineageTag: 6dae1b3c-928e-567d-b13b-d0c53f50dc7c

	measure 'Operating Expenses Total PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [Operating Expenses Total],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: $#,##0
		displayFolder: 4. NOI
		lineageTag: 93ad4534-501e-5e2a-80d5-08ef34662b58

	measure 'Operating Expenses Total Label' =
			VAR _d = DIVIDE ( [Operating Expenses Total] - [Operating Expenses Total PY], [Operating Expenses Total PY] )
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY"
		displayFolder: 8. Labels
		lineageTag: e62cc8eb-0948-5a28-a880-6c3c6ac79a1a

	measure 'Operating Expenses Total Color' =
			VAR _d = DIVIDE ( [Operating Expenses Total] - [Operating Expenses Total PY], [Operating Expenses Total PY] )
			RETURN
			    IF ( _d >= 0, "#D9735B", "#3E9B6E" )
		displayFolder: 9. Formatting
		lineageTag: 732b20bb-dfd4-56f9-83d5-a8feacd71281

	measure 'NOI PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [NOI],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: $#,##0
		displayFolder: 4. NOI
		lineageTag: 2a08617c-d86c-5e9c-b13f-1354335f8a4d

	measure 'NOI Label' =
			VAR _d = DIVIDE ( [NOI] - [NOI PY], [NOI PY] )
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY"
		displayFolder: 8. Labels
		lineageTag: 40656ff1-1a2f-5208-bd45-1a1df06a2976

	measure 'NOI Color' =
			VAR _d = DIVIDE ( [NOI] - [NOI PY], [NOI PY] )
			RETURN
			    IF ( _d >= 0, "#3E9B6E", "#D9735B" )
		displayFolder: 9. Formatting
		lineageTag: 66533b38-ab10-5869-855c-484994378521

