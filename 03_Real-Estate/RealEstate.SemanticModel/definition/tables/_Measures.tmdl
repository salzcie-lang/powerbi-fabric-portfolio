	measure 'Warning Color' = "#D9735B"
		displayFolder: 9. Formatting
		lineageTag: aa4c5076-9944-506f-a341-21092b08fd8a

	measure 'Good Color' = "#3E9B6E"
		displayFolder: 9. Formatting
		lineageTag: bf910d49-6106-5185-81e1-8b57e79b4e37

	measure 'Occupancy Color' = IF ( [Occupancy %] < 0.9, "#D9735B", "#2F6B4F" )
		displayFolder: 9. Formatting
		lineageTag: 1a83bbc7-cb69-5373-b004-0a24273d9044

	measure 'Occupancy Text Color' = IF ( [Occupancy %] < 0.9, "#D9735B", "#1F2A24" )
		displayFolder: 9. Formatting
		lineageTag: 095c3b39-a4f3-5ba7-a59c-7c850b503aea

	measure 'Collection Text Color' = IF ( [Collection Rate] < 0.93, "#D9735B", "#1F2A24" )
		displayFolder: 9. Formatting
		lineageTag: 1026602f-90e4-593d-bcbe-6cfe4b2a792c

	/// Inline SVG progress bar for occupancy.
	measure 'Occupancy Bar' =
			VAR _p = [Occupancy %]
			VAR _w = FORMAT ( ROUND ( MIN ( 1, _p ) * 100, 0 ), "0" )
			VAR _c = IF ( _p < 0.9, "%23D9735B", "%232F6B4F" )
			RETURN
			    IF ( NOT ISBLANK ( _p ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='104' height='16'><rect x='2' y='5' width='100' height='6' rx='3' fill='%23E8E1D3'/><rect x='2' y='5' width='" & _w & "' height='6' rx='3' fill='" & _c & "'/></svg>" )
		displayFolder: 9. Formatting
		lineageTag: 9c613148-99ec-5cbb-af50-a10c5e3ea61d
		dataCategory: ImageUrl

	/// Inline SVG progress bar for the collection rate.
	measure 'Collection Bar' =
			VAR _p = [Collection Rate]
			VAR _w = FORMAT ( ROUND ( MIN ( 1, _p ) * 100, 0 ), "0" )
			VAR _c = IF ( _p < 0.93, "%23D9735B", "%234E9A76" )
			RETURN
			    IF ( NOT ISBLANK ( _p ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='104' height='16'><rect x='2' y='5' width='100' height='6' rx='3' fill='%23E8E1D3'/><rect x='2' y='5' width='" & _w & "' height='6' rx='3' fill='" & _c & "'/></svg>" )
		displayFolder: 9. Formatting
		lineageTag: 990cd0b7-4fe4-5ef1-bccf-bdbe104ffb28
		dataCategory: ImageUrl

	measure 'Map Latitude' = AVERAGE ( 'Properties'[Latitude] )
		formatString: 0.0000
		displayFolder: 1. Portfolio
		lineageTag: dc81b1c3-58d6-51a5-810e-d34326a07155

	measure 'Map Longitude' = AVERAGE ( 'Properties'[Longitude] )
		formatString: 0.0000
		displayFolder: 1. Portfolio
		lineageTag: 20613ef9-e8d5-551c-9f03-0cf3e6f92410

	/// Large photo of the selected property, or a default photo when several are selected.
	measure 'Hero Photo' =
			IF (
			    HASONEVALUE ( 'Properties'[Property] ),
			    SELECTEDVALUE ( 'Properties'[Photo Large] ),
			    "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?w=1040&h=760&fit=crop&q=75"
			)
		displayFolder: 9. Formatting
		lineageTag: 4ebe7401-526e-54be-bb08-ecbd2b7bfaef
		dataCategory: ImageUrl

	column Placeholder
		dataType: string
		isHidden
		lineageTag: db3abf1d-e323-550b-8bfa-c432b3746259
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = User

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

