		displayFolder: 8. Labels
		lineageTag: bddece73-4398-5742-bd8a-f42136390248

	measure 'Maintenance Cost Color' =
			VAR _d = DIVIDE ( [Maintenance Cost] - [Maintenance Cost PY], [Maintenance Cost PY] )
			RETURN
