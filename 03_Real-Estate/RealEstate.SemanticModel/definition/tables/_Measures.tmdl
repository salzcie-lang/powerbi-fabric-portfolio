			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [NOI Margin],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: 0.0%
		displayFolder: 4. NOI
		lineageTag: 3cdf5a48-8d2c-526d-8d00-479fdf415674

	measure 'NOI Margin Label' =
			VAR _d = ( [NOI Margin] - [NOI Margin PY] ) * 100
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs PY"
		displayFolder: 8. Labels
		lineageTag: 52392215-9f85-5ee0-b7f0-76d5f01eac9a

