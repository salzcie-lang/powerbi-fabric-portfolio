	measure 'Avg Rent per Unit Label' = "per occupied unit"
		displayFolder: 8. Labels
		lineageTag: 486c2dbb-27c1-5c70-a79a-28409d5b5db8

	measure 'Neutral Color' = "#8C8676"
		displayFolder: 9. Formatting
