	measure 'Maintenance Cost PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [Maintenance Cost],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: $#,##0
		displayFolder: 5. Maintenance
		lineageTag: f3aadc37-84b2-5b09-8c05-5738e24cd8cb

	measure 'Maintenance Cost Label' =
			VAR _d = DIVIDE ( [Maintenance Cost] - [Maintenance Cost PY], [Maintenance Cost PY] )
			RETURN
