		displayFolder: 9. Formatting
		lineageTag: 9408edf2-73fb-5c73-9f09-9fc37645d77f

	measure 'Requests PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [Requests],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: #,##0
		displayFolder: 5. Maintenance
		lineageTag: 352f4c28-6b3e-5725-9f0e-03ca203cc80b

	measure 'Requests Label' =
			VAR _d = DIVIDE ( [Requests] - [Requests PY], [Requests PY] )
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY"
		displayFolder: 8. Labels
