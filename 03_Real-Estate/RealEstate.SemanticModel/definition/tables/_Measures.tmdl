	measure 'Portfolio Value Label' = "▲ " & FORMAT ( [Appreciation %], "0.0%" ) & " vs cost"
		displayFolder: 8. Labels
		lineageTag: e7456ff8-cba8-5f0c-8687-4b3dcfcd64c6

	measure 'Units Label' = [Properties] & " properties"
		displayFolder: 8. Labels
		lineageTag: f2d7bc03-a47a-5de3-8803-d5a4e0158246

	measure 'Vacant Units Label' = "of " & FORMAT ( [Units], "#,##0" ) & " units"
		displayFolder: 8. Labels
		lineageTag: bf791693-7e6a-57fb-b2ad-3645cb61708b

	measure 'Outstanding Rent Label' = FORMAT ( DIVIDE ( [Outstanding Rent], [Rent Due] ), "0.0%" ) & " of rent due"
		displayFolder: 8. Labels
		lineageTag: 9bda669f-0e17-55f7-b169-739ff4b956f4

	measure 'Expiring Leases Label' = FORMAT ( [Expiring Rent] / 1000, "$#,##0" ) & "K / mo at risk"
		displayFolder: 8. Labels
		lineageTag: 3ea99adf-8af4-5ebe-b5b4-8607d3dc93d9

	measure 'Open Requests Label' = "of " & FORMAT ( [Requests], "#,##0" ) & " requests"
		displayFolder: 8. Labels
