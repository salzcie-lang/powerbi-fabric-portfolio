table fact_service_request
	lineageTag: cb666b16-ff70-5c34-9238-6e3bb660737a

	measure 'Total Requests' = COUNTROWS(fact_service_request)
		formatString: #,0
		lineageTag: 4840406c-7671-5af8-80ee-b9977db15cf2

	measure 'Closed Requests' = CALCULATE([Total Requests], fact_service_request[is_closed] = TRUE())
		formatString: #,0
		lineageTag: ea4c82fa-6119-552d-9f22-79ad70d8dd27

	measure 'Open Requests' = [Total Requests] - [Closed Requests]
		formatString: #,0
		lineageTag: de31503f-bdc0-5ae8-995f-c4d403e7ca12

	measure 'Closure Rate' = DIVIDE([Closed Requests], [Total Requests])
		formatString: 0.0%
		lineageTag: 359d03ad-ac3a-59e4-a1bd-4f92c8484899

	measure 'Avg Resolution Hours' = AVERAGE(fact_service_request[resolution_hours])
		formatString: #,0.0
		lineageTag: b128f0a8-0078-5a14-9ab5-b16fbbd8e3f4

	measure 'Closed Within Due %' = DIVIDE(CALCULATE(COUNTROWS(fact_service_request), fact_service_request[closed_within_due] = TRUE()), CALCULATE(COUNTROWS(fact_service_request), NOT ISBLANK(fact_service_request[closed_within_due])))
		formatString: 0.0%
		lineageTag: 401397ab-a0ae-57c4-9d16-adf628bcee56

