	/// Cash at period end, months of operating cost it covers, and free cash flow for each month.
	measure 'SVG Cash' =
			VAR _cash = [Cash Balance]
			VAR _chg = [Cash Change]
			VAR _cover = [Cash Cover Months]
			VAR _cc = IF ( _chg >= 0, "#5BE3B0", "#FF6B7A" )
			VAR _fT = ADDCOLUMNS ( FILTER ( VALUES ( 'Date'[Month Start] ), NOT ISBLANK ( [Free Cash Flow] ) ), "@v", [Free Cash Flow] )
			VAR _fN = COUNTROWS ( _fT )
			VAR _fF = MINX ( _fT, 'Date'[Month Start] )
			VAR _fL = MAXX ( _fT, 'Date'[Month Start] )
			VAR _fM = MAXX ( _fT, ABS ( [@v] ) )
			VAR _step = DIVIDE ( 268, _fN )
			VAR _last = MAXX ( FILTER ( _fT, 'Date'[Month Start] = _fL ), [@v] )
			VAR _bars = CONCATENATEX ( _fT, VAR _i = DATEDIFF ( _fF, 'Date'[Month Start], MONTH ) VAR _cx = 18 + _step * ( _i + 0.5 ) VAR _h = MAX ( 28 * DIVIDE ( ABS ( [@v] ), _fM ), 4 ) RETURN "<rect x='" &
			    FORMAT ( _cx - 6, "0.0", "en-US" ) &
			    "' y='" &
			    FORMAT ( IF ( [@v] >= 0, 150 - _h, 150 ), "0.0", "en-US" ) &
			    "' width='12' height='" &
			    FORMAT ( _h, "0.0", "en-US" ) &
			    "' rx='6' fill='" &
			    IF ( [@v] >= 0, "url(#gBv)", "url(#gOv)" ) &
			    "' fill-opacity='" &
			    IF ( _i = _fN - 1, "1", "0.6" ) &
			    "'/>" &
			    "<text x='" &
			    FORMAT ( _cx, "0.0", "en-US" ) &
			    "' y='197' font-family='Segoe UI' font-size='8' text-anchor='middle' fill='#5F6880'>" &
			    LEFT ( FORMAT ( 'Date'[Month Start], "MMM", "en-US" ), 1 ) &
			    "</text>", "" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 304 210'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='304' height='210'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<text x='" &
			    "18" &
			    "' y='" &
			    "76" &
			    "' font-family='Segoe UI' font-size='27' font-weight='600' text-anchor='start' letter-spacing='-0.4' fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _cash ) >= 1000000, FORMAT ( _cash / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _cash / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    IF ( ISBLANK ( _chg ), "", "<path transform='translate(18,85.5)' d='" &
			    IF ( _chg >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" ) &
			    "' fill='" &
			    _cc &
			    "'/>" &
			    "<text x='" &
			    "31" &
			    "' y='" &
			    "93" &
			    "' font-family='Segoe UI' font-size='9.5' font-weight='600' text-anchor='start'  fill='" &
			    _cc &
			    "'>" &
			    IF ( ABS ( ABS ( _chg ) ) >= 1000000, FORMAT ( ABS ( _chg ) / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( ABS ( _chg ) / 1000, "$0", "en-US" ) & "K" ) &
			    " since period start" &
			    "</text>" ) &
			    "<text x='" &
			    "286" &
			    "' y='" &
			    "64" &
			    "' font-family='Segoe UI' font-size='15' font-weight='600' text-anchor='end'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    FORMAT ( _cover, "0.0", "en-US" ) &
			    " mo" &
			    "</text>" &
			    "<text x='" &
			    "286" &
			    "' y='" &
			    "77" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='end'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "cost cover" &
			    "</text>" &
			    "<text x='" &
			    "18" &
			    "' y='" &
			    "114" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "Free cash flow by month" &
			    "</text>" &
			    "<text x='" &
			    "286" &
			    "' y='" &
			    "114" &
			    "' font-family='Segoe UI' font-size='9' font-weight='600' text-anchor='end'  fill='" &
			    IF ( _last >= 0, "#7AB0FF", "#FFB86B" ) &
			    "'>" &
			    FORMAT ( _fL, "MMM", "en-US" ) &
			    "  " &
			    IF ( _last < 0, "-", "" ) &
			    IF ( ABS ( ABS ( _last ) ) >= 1000000, FORMAT ( ABS ( _last ) / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( ABS ( _last ) / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<line x1='18' x2='286' y1='150' y2='150' stroke='#FFFFFF' stroke-opacity='0.14'/>" &
			    _bars &
			    "</svg>"
		displayFolder: 7. SVG visuals
		lineageTag: 5176e8b2-be8d-5440-a4eb-d42c6c00c996
		dataCategory: ImageUrl

	/// Days sales, inventory and payables outstanding, and the cash conversion cycle they add up to.
	measure 'SVG Cash Cycle' =
			VAR _v0 = [DSO]
			VAR _p0 = [DSO PY]
			VAR _d0 = MAX ( MIN ( DIVIDE ( _v0, 120 ), 1 ), 0 ) * 175.93
			VAR _x0D = IF ( NOT ISBLANK ( _p0 ), _v0 - _p0 )
			VAR _x0C = IF ( _x0D >= 0, "#FF6B7A", "#5BE3B0" )
			VAR _x0S = FORMAT ( ABS ( _x0D ), "0", "en-US" ) & "d vs PY"
			VAR _x0A = IF ( _x0D >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" )
			VAR _v1 = [DIO]
			VAR _p1 = [DIO PY]
			VAR _d1 = MAX ( MIN ( DIVIDE ( _v1, 120 ), 1 ), 0 ) * 175.93
			VAR _x1D = IF ( NOT ISBLANK ( _p1 ), _v1 - _p1 )
			VAR _x1C = IF ( _x1D >= 0, "#FF6B7A", "#5BE3B0" )
			VAR _x1S = FORMAT ( ABS ( _x1D ), "0", "en-US" ) & "d vs PY"
			VAR _x1A = IF ( _x1D >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" )
			VAR _v2 = [DPO]
			VAR _p2 = [DPO PY]
			VAR _d2 = MAX ( MIN ( DIVIDE ( _v2, 120 ), 1 ), 0 ) * 175.93
			VAR _x2D = IF ( NOT ISBLANK ( _p2 ), _v2 - _p2 )
			VAR _x2C = IF ( _x2D >= 0, "#5BE3B0", "#FF6B7A" )
			VAR _x2S = FORMAT ( ABS ( _x2D ), "0", "en-US" ) & "d vs PY"
			VAR _x2A = IF ( _x2D >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" )
			VAR _ccc = [Cash Conversion Cycle]
			VAR _cpy = [Cash Conversion Cycle PY]
			VAR _zD = IF ( NOT ISBLANK ( _cpy ), _ccc - _cpy )
			VAR _zC = IF ( _zD >= 0, "#FF6B7A", "#5BE3B0" )
			VAR _zS = FORMAT ( ABS ( _zD ), "0", "en-US" ) & "d vs PY"
			VAR _zA = IF ( _zD >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 390 198'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='390' height='198'><feGaussianBlur stdDeviation='4'/></filter></defs>" &
			    "<circle cx='56' cy='98' r='28' fill='none' stroke='#FFFFFF' stroke-opacity='0.07' stroke-width='7'/>" &
			    "<circle cx='56' cy='98' r='28' fill='none' stroke='#4C8DFF' stroke-width='8' stroke-linecap='round' opacity='0.5' filter='url(#gl)' transform='rotate(-90 56 98)' stroke-dasharray='" &
			    FORMAT ( _d0, "0.0", "en-US" ) &
			    " 200'/>" &
			    "<circle cx='56' cy='98' r='28' fill='none' stroke='#4C8DFF' stroke-width='7' stroke-linecap='round' transform='rotate(-90 56 98)' stroke-dasharray='" &
			    FORMAT ( _d0, "0.0", "en-US" ) &
			    " 200'/>" &
			    "<text x='" &
			    "56" &
			    "' y='" &
			    "104" &
			    "' font-family='Segoe UI' font-size='17' font-weight='600' text-anchor='middle'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    FORMAT ( _v0, "0", "en-US" ) &
