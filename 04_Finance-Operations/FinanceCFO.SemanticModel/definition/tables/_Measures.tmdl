	measure 'Var % vs Budget' =
			VAR _a = [PnL Value]
			VAR _b = [PnL Budget]
			VAR _ratio = SELECTEDVALUE ( 'PnL Lines'[Line Type] ) = "ratio"
			RETURN
			    IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), IF ( NOT _ratio, FORMAT ( DIVIDE ( _a - _b, ABS ( _b ) ), "+0.0%;-0.0%" ) ) )
