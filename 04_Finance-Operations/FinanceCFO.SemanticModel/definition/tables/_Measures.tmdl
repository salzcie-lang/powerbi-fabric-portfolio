			    "171" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#5F6880" &
			    "'>" &
			    IF ( ABS ( [Net Income] ) >= 1000000, FORMAT ( [Net Income] / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( [Net Income] / 1000, "$0", "en-US" ) & "K" ) &
			    " of " &
			    IF ( ABS ( [Net Income Budget] ) >= 1000000, FORMAT ( [Net Income Budget] / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( [Net Income Budget] / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
