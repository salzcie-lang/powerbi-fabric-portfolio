	/// Department operating expense against budget, as a diverging bar.
	measure 'SVG Dept Bar' =
			VAR _v = [OpEx Variance %]
			VAR _m = MAX ( MAXX ( ALLSELECTED ( Departments[Department] ), ABS ( [OpEx Variance %] ) ), 0.02 )
			VAR _w = MAX ( 44 * DIVIDE ( ABS ( _v ), _m ), 2 )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 16'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='96' height='16'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<line x1='48' x2='48' y1='1' y2='15' stroke='#FFFFFF' stroke-opacity='0.25'/>" &
			    "<rect x='" &
			    FORMAT ( IF ( _v >= 0, 48, 48 - _w ), "0.0", "en-US" ) &
			    "' y='4' width='" &
			    FORMAT ( _w, "0.0", "en-US" ) &
			    "' height='8' rx='4' fill='" &
			    IF ( _v >= 0, "url(#gO)", "url(#gG)" ) &
			    "'/>" &
			    "</svg>"
		displayFolder: 7. SVG visuals
		lineageTag: 132c6648-5819-55b2-84bf-04f2a6537cf7
		dataCategory: ImageUrl

	/// Overdue amount per customer relative to the largest; orange when the oldest invoice is 90+ days late.
	measure 'SVG Overdue Bar' =
			VAR _v = [AR Overdue]
			VAR _m = MAXX ( ALLSELECTED ( Receivables[Customer] ), [AR Overdue] )
			VAR _w = MAX ( 104 * DIVIDE ( _v, _m ), 3 )
			VAR _c = IF ( [Oldest Days Overdue] > 90, "url(#gO)", "url(#gB)" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 110 14'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='110' height='14'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<rect x='2' y='4' width='104' height='6' rx='3' fill='#FFFFFF' fill-opacity='0.07'/>" &
			    "<rect x='2' y='4' width='" &
			    FORMAT ( _w, "0.0", "en-US" ) &
			    "' height='6' rx='3' fill='" &
			    _c &
			    "'/>" &
			    "</svg>"
		displayFolder: 7. SVG visuals
		lineageTag: 2c30e726-6c28-5f9f-b64e-5fa6401b424e
		dataCategory: ImageUrl

	/// Variance to budget for a statement line; green is favourable.
	measure 'SVG Line Bar' =
			VAR _a = [PnL Value]
			VAR _b = [PnL Budget]
			VAR _cost = SELECTEDVALUE ( 'PnL Lines'[Line Order] ) IN { 5, 8, 9, 10, 11, 12, 13, 14, 17, 18, 19 }
			VAR _rel = IF ( SELECTEDVALUE ( 'PnL Lines'[Line Type] ) = "ratio", ( _a - _b ) * 10, DIVIDE ( _a - _b, ABS ( _b ) ) )
			VAR _w = MAX ( 46 * MIN ( DIVIDE ( ABS ( _rel ), 0.16 ), 1 ), 2 )
			VAR _good = ( _rel > 0 ) <> _cost
			RETURN
			    IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 16'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='100' height='16'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<line x1='50' x2='50' y1='1' y2='15' stroke='#FFFFFF' stroke-opacity='0.25'/>" &
			    "<rect x='" &
			    FORMAT ( IF ( _rel >= 0, 50, 50 - _w ), "0.0", "en-US" ) &
			    "' y='4' width='" &
			    FORMAT ( _w, "0.0", "en-US" ) &
			    "' height='8' rx='4' fill='" &
			    IF ( _good, "url(#gG)", "url(#gO)" ) &
			    "'/>" &
			    "</svg>" )
		displayFolder: 7. SVG visuals
		lineageTag: 5a7bf79b-1898-5307-9b4e-2cf8233828eb
		dataCategory: ImageUrl

	/// Monthly trend of a statement line.
	measure 'SVG Line Trend' =
			VAR _sT = ADDCOLUMNS ( FILTER ( VALUES ( 'Date'[Month Start] ), NOT ISBLANK ( [PnL Value] ) ), "@v0", [PnL Value] )
			VAR _sN = COUNTROWS ( _sT )
			VAR _sF = MINX ( _sT, 'Date'[Month Start] )
			VAR _sLo = MINX ( _sT, [@v0] )
			VAR _sHi = MAXX ( _sT, [@v0] )
			VAR _sR = IF ( _sHi - _sLo = 0, 1, _sHi - _sLo )
			VAR _sP1 = ADDCOLUMNS ( _sT, "@i", DATEDIFF ( _sF, 'Date'[Month Start], MONTH ) )
			VAR _sP2 = ADDCOLUMNS ( _sP1, "@x", 4 + 92 * DIVIDE ( [@i], _sN - 1, 0.5 ), "@y0", 15 - 12 * DIVIDE ( [@v0] - _sLo, _sR ) )
			VAR _sQ = ADDCOLUMNS ( _sP2, "@nx", VAR _i = [@i] RETURN MAXX ( FILTER ( _sP2, [@i] = _i + 1 ), [@x] ), "@ny0", VAR _i = [@i] RETURN MAXX ( FILTER ( _sP2, [@i] = _i + 1 ), [@y0] ) )
			VAR _sFX = MAXX ( FILTER ( _sQ, [@i] = 0 ), [@x] )
			VAR _sLX = MAXX ( FILTER ( _sQ, [@i] = _sN - 1 ), [@x] )
			VAR _sFY0 = MAXX ( FILTER ( _sQ, [@i] = 0 ), [@y0] )
			VAR _sLY0 = MAXX ( FILTER ( _sQ, [@i] = _sN - 1 ), [@y0] )
			VAR _sPath0 = "M" & FORMAT ( _sFX, "0.0", "en-US" ) & "," & FORMAT ( _sFY0, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _sQ, NOT ISBLANK ( [@nx] ) ), IF ( [@i] = 0, " L", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y0], "0.0", "en-US" ) & " " ) & FORMAT ( ( [@x] + [@nx] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y0] + [@ny0] ) / 2, "0.0", "en-US" ), "", [@i], ASC ) & " L" & FORMAT ( _sLX, "0.0", "en-US" ) & "," & FORMAT ( _sLY0, "0.0", "en-US" )
			VAR _sArea = _sPath0 & " L" & FORMAT ( _sLX, "0.0", "en-US" ) & ",23 L" & FORMAT ( _sFX, "0.0", "en-US" ) & ",23 Z"
			RETURN
			    IF ( _sN > 1, "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 18'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='100' height='18'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<path d='" &
			    _sPath0 &
			    "' fill='none' stroke='#7AB0FF' stroke-width='1.6' stroke-linecap='round'/>" &
			    "<circle cx='" &
			    FORMAT ( _sLX, "0.0", "en-US" ) &
			    "' cy='" &
			    FORMAT ( _sLY0, "0.0", "en-US" ) &
			    "' r='2' fill='#FFFFFF'/>" &
			    "</svg>" )
		displayFolder: 7. SVG visuals
		lineageTag: 6d21e5fb-c96e-588b-96e0-95010ec084ca
		dataCategory: ImageUrl

	/// Days past due of the oldest open invoice.
	measure 'Oldest Days Overdue' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE (
			        MAXX ( Receivables, DATEDIFF ( Receivables[Due Date], _pe, DAY ) ),
			        REMOVEFILTERS ( 'Date' ),
			        FILTER (
			            ALL ( Receivables[Invoice Date], Receivables[Paid Date] ),
			            Receivables[Invoice Date] <= _pe && ( ISBLANK ( Receivables[Paid Date] ) || Receivables[Paid Date] > _pe )
			        )
			    )
		formatString: 0
		displayFolder: 4. Working capital
		lineageTag: 04bd5a84-4ac9-59f8-87b8-a63331aec6d7

	measure 'PnL Variance' = [PnL Value] - [PnL Budget]
		formatString: $#,##0
		displayFolder: 6. Statement
		lineageTag: 39f29616-f7f8-5d8c-a9b9-95fb3f80530e

	measure 'PnL Variance %' = DIVIDE ( [PnL Value] - [PnL Budget], ABS ( [PnL Budget] ) )
		formatString: +0.0%;-0.0%
		displayFolder: 6. Statement
		lineageTag: 0d8f737f-2daf-5332-9fb9-c7150f4e4ad3

	measure 'Pct of Revenue' = DIVIDE ( [PnL Value], [Revenue] )
		formatString: 0.0%
		displayFolder: 6. Statement
		lineageTag: 7359dbfb-1aee-5081-98ed-a9bed3a20ad1

	measure Interest = CALCULATE ( [GL Amount], Accounts[AccountCode] = 7100 )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: c7911cb4-57a2-51fb-93ff-9283fe36500f

	measure 'Income Tax' = CALCULATE ( [GL Amount], Accounts[AccountCode] = 7200 )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: db4649b6-611f-533a-a949-c62562c9620f

	/// Lower edge of a bridge bar: zero for totals, the level after the deduction for cost steps.
	measure 'Bridge Low' =
			SWITCH (
			    SELECTEDVALUE ( 'PnL Lines'[Bridge Order] ),
			    2, [Gross Profit],
			    4, [EBITDA],
			    6, [EBITDA] - [Depreciation],
			    7, [EBITDA] - [Depreciation] - [Interest],
			    8, [Net Income],
			    0
			)
		formatString: $#,##0
		displayFolder: 6. Statement
		lineageTag: 465f6836-0042-522b-8df0-f0c1334e54e3

	/// Upper edge of a bridge bar.
	measure 'Bridge High' =
			SWITCH (
			    SELECTEDVALUE ( 'PnL Lines'[Bridge Order] ),
			    1, [Revenue],
			    2, [Revenue],
			    3, [Gross Profit],
			    4, [Gross Profit],
			    5, [EBITDA],
			    6, [EBITDA],
			    7, [EBITDA] - [Depreciation],
			    8, [Net Income] + [Income Tax],
			    9, [Net Income]
			)
		formatString: $#,##0
		displayFolder: 6. Statement
		lineageTag: 2c8c7b8e-1ae6-5e0d-9009-39c3b273dc3b

	measure 'Focus Value' = IF ( HASONEVALUE ( 'PnL Lines'[Line Order] ), [PnL Value], [Revenue] )
		formatString: $#,##0
		displayFolder: 6. Statement
		lineageTag: ce656ed9-350b-57d1-85f1-fbd979675297

	measure 'Focus Budget' = IF ( HASONEVALUE ( 'PnL Lines'[Line Order] ), [PnL Budget], [Revenue Budget] )
		formatString: $#,##0
		displayFolder: 6. Statement
		lineageTag: 25ef3400-3297-59ad-815b-e1167a77d34f

	measure 'Focus PY' = IF ( HASONEVALUE ( 'PnL Lines'[Line Order] ), [PnL PY], [Revenue PY] )
		formatString: $#,##0
		displayFolder: 6. Statement
		lineageTag: 10e73713-03ec-5891-8977-4c05b0ad869d

	/// Total operating expenses against budget.
	measure 'SVG OpEx Total' =
			VAR _tv = [OpEx Variance %]
			VAR _ta = [OpEx Variance]
			VAR _tc = IF ( _tv > 0, "#FFB86B", "#5BE3B0" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 296 26'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='296' height='26'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<text x='" &
			    "16" &
			    "' y='" &
			    "15" &
			    "' font-family='Segoe UI' font-size='9.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "Total OpEx" &
			    "</text>" &
			    "<text x='" &
			    "280" &
			    "' y='" &
			    "15" &
			    "' font-family='Segoe UI' font-size='9.5' font-weight='600' text-anchor='end'  fill='" &
			    _tc &
			    "'>" &
			    FORMAT ( _tv, "+0.0%;-0.0%", "en-US" ) &
			    "  ·  " &
			    IF ( ABS ( ABS ( _ta ) ) >= 1000000, FORMAT ( ABS ( _ta ) / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( ABS ( _ta ) / 1000, "$0", "en-US" ) & "K" ) &
			    IF ( _ta > 0, " over", " under" ) &
			    "</text>" &
			    "</svg>"
		displayFolder: 7. SVG visuals
		lineageTag: c2f805a3-99a8-5b55-ba19-51a8d1b1ab69
		dataCategory: ImageUrl

	column Placeholder
		dataType: string
		isHidden
		lineageTag: db3abf1d-e323-550b-8bfa-c432b3746259
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = User

	partition _Measures = m
		mode: import
