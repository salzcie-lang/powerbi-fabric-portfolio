table _Measures
	lineageTag: b582f3ce-9fd6-5634-b599-dc61df992f28

	/// Last day of the latest month with posted actuals; used as today.
	measure 'As Of Date' = EOMONTH ( CALCULATE ( MAX ( GL[Month] ), REMOVEFILTERS () ), 0 )
		formatString: dd mmm yyyy
		displayFolder: 0. Base
		lineageTag: 1fbe3912-fd5b-5ffc-ae89-ed8ccb4326c4

	/// Last date of the selection, capped at the as-of date. Balances are read at this date.
	measure 'Period End' = MIN ( MAX ( 'Date'[Date] ), [As Of Date] )
		formatString: dd mmm yyyy
		displayFolder: 0. Base
		lineageTag: 51d1c055-d1f1-5f87-b17b-74e8b1c6db0c

	measure 'GL Amount' = SUM ( GL[Amount] )
		formatString: $#,##0
		displayFolder: 0. Base
		lineageTag: 9dca086e-e318-5809-a28c-0af362ffad84

	measure 'Budget Amount' = SUM ( Budget[Budget Amount] )
		formatString: $#,##0
		displayFolder: 0. Base
		lineageTag: 9c172e68-a893-5aa8-98cd-c13629ccbb00

	measure Revenue = CALCULATE ( [GL Amount], Accounts[PnL Section] = "Revenue" )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: ce7d0117-7a6e-5a86-9530-cc5c1949e6fd

	measure COGS = CALCULATE ( [GL Amount], Accounts[PnL Section] = "COGS" )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 02fa8fd2-8a3e-5a22-8901-291fb19a0120

	measure OpEx = CALCULATE ( [GL Amount], Accounts[PnL Section] = "OpEx" )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 52909568-d07a-58c8-a7b2-382501012393

	measure 'Below EBITDA' = CALCULATE ( [GL Amount], Accounts[PnL Section] = "Below EBITDA" )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 54514eb0-a386-5004-b639-5d38f3711f48

	measure 'Gross Profit' = [Revenue] - [COGS]
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 57e6a1a1-2d36-58a3-a2b3-20dc97ae67df

	measure 'Gross Margin' = DIVIDE ( [Gross Profit], [Revenue] )
		formatString: 0.0%
		displayFolder: 1. P&L
		lineageTag: eb8fae72-651b-53d8-ad11-6ecff06d2ab2

	measure EBITDA = [Gross Profit] - [OpEx]
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 2a299b31-06c8-5568-94b1-0d273727fd6a

	measure 'EBITDA Margin' = DIVIDE ( [EBITDA], [Revenue] )
		formatString: 0.0%
		displayFolder: 1. P&L
		lineageTag: 93e736f7-bd0b-522d-946c-8a3be23c21cd

	measure 'Net Income' = [EBITDA] - [Below EBITDA]
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 1e23e142-4036-5cd2-b67e-ec44604ebfac

	measure 'Net Margin' = DIVIDE ( [Net Income], [Revenue] )
		formatString: 0.0%
		displayFolder: 1. P&L
		lineageTag: 6eb6e46b-69ad-514e-9700-2d1cbdc04dd7

	/// Operating expenses as a share of revenue.
	measure 'OpEx Ratio' = DIVIDE ( [OpEx], [Revenue] )
		formatString: 0.0%
		displayFolder: 1. P&L
		lineageTag: b363610a-f5bc-5f22-afec-c872ee18818f

	measure 'Revenue Budget' = CALCULATE ( [Budget Amount], Accounts[PnL Section] = "Revenue" )
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: 258003e5-7c31-593c-b01e-237f33b5fce9

	measure 'COGS Budget' = CALCULATE ( [Budget Amount], Accounts[PnL Section] = "COGS" )
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: c84bfbd8-fd3e-5e9e-8572-4660c43f45c0

	measure 'OpEx Budget' = CALCULATE ( [Budget Amount], Accounts[PnL Section] = "OpEx" )
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: 063e4d58-2325-551b-8905-9eabc5e1e921

	measure 'Below EBITDA Budget' = CALCULATE ( [Budget Amount], Accounts[PnL Section] = "Below EBITDA" )
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: d4c6d5d6-ff15-59a9-912c-687aa7d7592d

	measure 'Gross Profit Budget' = [Revenue Budget] - [COGS Budget]
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: c7e2b9c6-75f3-5049-bc91-4b4a8a7fc7bd

	measure 'Gross Margin Budget' = DIVIDE ( [Gross Profit Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: e7177cb3-34e7-5b57-aca7-4465abbd5425

	measure 'EBITDA Budget' = [Gross Profit Budget] - [OpEx Budget]
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: 0054202d-0a1b-5cbb-89af-3449a0804b8f

	measure 'EBITDA Margin Budget' = DIVIDE ( [EBITDA Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: 42ed9e4d-dcfe-54bf-bdb9-c5d85caaf491

	measure 'Net Income Budget' = [EBITDA Budget] - [Below EBITDA Budget]
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: 777c5dee-0b4a-54f9-82c6-02c6563580ea

	measure 'Net Margin Budget' = DIVIDE ( [Net Income Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: 1e60da26-3eba-51fc-9ec1-166c5a01389e

	/// Operating expenses as a share of revenue.
	measure 'OpEx Ratio Budget' = DIVIDE ( [OpEx Budget], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: 271a9e2b-bfea-5d9d-b62e-dfd682c0fbbe

	measure Depreciation = CALCULATE ( [GL Amount], Accounts[AccountCode] = 7000 )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 0415204b-a4be-59e7-bf0a-dfeebf4c31c6

	measure 'Interest and Tax' = CALCULATE ( [GL Amount], Accounts[AccountCode] IN { 7100, 7200 } )
		formatString: $#,##0
		displayFolder: 1. P&L
		lineageTag: 1eca29a2-15e2-56ea-972c-e99ad03a8c56

	measure 'OpEx Variance' = [OpEx] - [OpEx Budget]
		formatString: $#,##0
		displayFolder: 2. Budget
		lineageTag: 8edf6394-74b4-598b-b9eb-eda1fd52ca81

	measure 'OpEx Variance %' = DIVIDE ( [OpEx] - [OpEx Budget], [OpEx Budget] )
		formatString: +0.0%;-0.0%
		displayFolder: 2. Budget
		lineageTag: 6ac8f744-d5db-569d-bea7-1c51a4b7f1f5

	measure 'Revenue Attainment' = DIVIDE ( [Revenue], [Revenue Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: 3c12e0d5-cd79-5c41-a4ea-ddf312ba1d00

	measure 'Gross Profit Attainment' = DIVIDE ( [Gross Profit], [Gross Profit Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: 9b6dc654-a5d8-58d0-9570-4247957cff57

	measure 'EBITDA Attainment' = DIVIDE ( [EBITDA], [EBITDA Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: 9418e647-c28f-58b6-b773-67ee3e8c2f8a

	measure 'Net Income Attainment' = DIVIDE ( [Net Income], [Net Income Budget] )
		formatString: 0.0%
		displayFolder: 2. Budget
		lineageTag: bee6cb91-799a-512e-bae3-98a1eca875b0

	/// Cash at the end of the selected period.
	measure 'Cash Balance' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE ( SUM ( Cash[Cash Balance] ), REMOVEFILTERS ( 'Date' ), Cash[Month] = EOMONTH ( _pe, -1 ) + 1 )
		formatString: $#,##0
		displayFolder: 3. Cash
		lineageTag: e021559c-1d1a-5a21-afca-b8b91b2bcca9

	/// Change in cash since the start of the selected period.
	measure 'Cash Change' =
			VAR _first = MIN ( 'Date'[Date] )
			VAR _open = CALCULATE ( SUM ( Cash[Cash Balance] ), REMOVEFILTERS ( 'Date' ), Cash[Month] = EOMONTH ( _first, -2 ) + 1 )
			RETURN
			    IF ( NOT ISBLANK ( _open ), [Cash Balance] - _open )
		formatString: $#,##0
		displayFolder: 3. Cash
		lineageTag: c7e3366f-84c8-540f-b8ea-b515e3bd4ea8

	measure 'Operating Cash Flow' = SUM ( Cash[Operating Cash Flow] )
		formatString: $#,##0
		displayFolder: 3. Cash
		lineageTag: 39f242fc-bf7c-52c4-841c-104c43561d20

	measure Capex = SUM ( Cash[Capex] )
		formatString: $#,##0
		displayFolder: 3. Cash
		lineageTag: 871741c7-a8df-504a-8ccf-d0d643cd4d4f

	measure 'Free Cash Flow' = [Operating Cash Flow] - [Capex]
		formatString: $#,##0
		displayFolder: 3. Cash
		lineageTag: b06e2a6c-e136-562a-a212-fb0c530cf289

	/// Cash divided by average monthly operating cost over the last three months.
	measure 'Cash Cover Months' =
			VAR _pe = [Period End]
			VAR _cost = CALCULATE ( [COGS] + [OpEx], REMOVEFILTERS ( 'Date' ), DATESINPERIOD ( 'Date'[Date], _pe, -3, MONTH ) )
			RETURN
			    DIVIDE ( [Cash Balance], _cost / 3 )
		formatString: 0.0
		displayFolder: 3. Cash
		lineageTag: 97215c34-9da4-5323-a041-a9a82a1f8a86

	/// Invoices issued and not yet paid at the end of the period.
	measure 'AR Balance' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE (
			        SUM ( Receivables[Amount] ),
			        REMOVEFILTERS ( 'Date' ),
			        FILTER (
			            ALL ( Receivables[Invoice Date], Receivables[Paid Date] ),
			            Receivables[Invoice Date] <= _pe && ( ISBLANK ( Receivables[Paid Date] ) || Receivables[Paid Date] > _pe )
			        )
			    )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: 4a460822-d359-563d-acda-d1191c1fdbcd

	measure 'Inventory Value' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE ( SUM ( Inventory[Inventory Value] ), REMOVEFILTERS ( 'Date' ), Inventory[Month] = EOMONTH ( _pe, -1 ) + 1 )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: 46b73363-a60c-5f91-b01d-2217b79e19f2

	measure 'AP Balance' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE ( SUM ( Cash[Accounts Payable] ), REMOVEFILTERS ( 'Date' ), Cash[Month] = EOMONTH ( _pe, -1 ) + 1 )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: cd90f033-4add-5158-825e-246bf66f4e9a

	measure 'Revenue T3M' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE ( [Revenue], REMOVEFILTERS ( 'Date' ), DATESINPERIOD ( 'Date'[Date], _pe, -3, MONTH ) )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: 0d430014-17c7-57f7-9f8a-fdc1cbfe1e6f

	measure 'COGS T3M' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE ( [COGS], REMOVEFILTERS ( 'Date' ), DATESINPERIOD ( 'Date'[Date], _pe, -3, MONTH ) )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: f78b5a3c-213f-5df6-a978-6b259142482a

	/// Days sales outstanding.
	measure DSO = DIVIDE ( [AR Balance], [Revenue T3M] ) * 91
		formatString: 0
		displayFolder: 4. Working capital
		lineageTag: 44915e32-febb-5d66-9bc7-002ac95d3dc0

	/// Days inventory outstanding.
	measure DIO = DIVIDE ( [Inventory Value], [COGS T3M] ) * 91
		formatString: 0
		displayFolder: 4. Working capital
		lineageTag: c3c95fac-5f4a-5516-aa55-13537f04adfb

	/// Days payables outstanding.
	measure DPO = DIVIDE ( [AP Balance], [COGS T3M] ) * 91
		formatString: 0
		displayFolder: 4. Working capital
		lineageTag: c561e5b5-f646-5c21-9d2e-52ded50f73b9

	measure 'Cash Conversion Cycle' = [DSO] + [DIO] - [DPO]
		formatString: 0
		displayFolder: 4. Working capital
		lineageTag: d684245d-7a2a-57c5-9e68-2e2a68004de7

	measure 'AR Current' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE (
			        SUM ( Receivables[Amount] ),
			        REMOVEFILTERS ( 'Date' ),
			        FILTER (
			            ALL ( Receivables[Invoice Date], Receivables[Paid Date], Receivables[Due Date] ),
			            Receivables[Invoice Date] <= _pe && ( ISBLANK ( Receivables[Paid Date] ) || Receivables[Paid Date] > _pe )
			                && _pe - Receivables[Due Date] <= 0
			        )
			    )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: 1bffbb89-ad51-5278-ba83-f50f63091ef1

	measure 'AR 1-30' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE (
			        SUM ( Receivables[Amount] ),
			        REMOVEFILTERS ( 'Date' ),
			        FILTER (
			            ALL ( Receivables[Invoice Date], Receivables[Paid Date], Receivables[Due Date] ),
			            Receivables[Invoice Date] <= _pe && ( ISBLANK ( Receivables[Paid Date] ) || Receivables[Paid Date] > _pe )
			                && _pe - Receivables[Due Date] > 0 && _pe - Receivables[Due Date] <= 30
			        )
			    )
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: 7523d59a-3447-56b2-bc9b-099dae7241f0

	measure 'AR 31-60' =
