	/// Ring: EBITDA against budget. Rows: revenue, gross profit and net income against budget, tick marks 100%.
	measure 'SVG Budget Ring' =
			VAR _att = [EBITDA Attainment]
			VAR _dash = MAX ( MIN ( _att, 1 ), 0 ) * 339.29
			VAR _r0 = [Revenue Attainment]
			VAR _c0 = SWITCH ( TRUE (), _r0 >= 0.995, "url(#gG)", _r0 >= 0.95, "url(#gB)", "url(#gO)" )
			VAR _w0 = 148 * MAX ( MIN ( _r0 / 1.2, 1 ), 0.02 )
			VAR _r1 = [Gross Profit Attainment]
			VAR _c1 = SWITCH ( TRUE (), _r1 >= 0.995, "url(#gG)", _r1 >= 0.95, "url(#gB)", "url(#gO)" )
			VAR _w1 = 148 * MAX ( MIN ( _r1 / 1.2, 1 ), 0.02 )
			VAR _r2 = [Net Income Attainment]
			VAR _c2 = SWITCH ( TRUE (), _r2 >= 0.995, "url(#gG)", _r2 >= 0.95, "url(#gB)", "url(#gO)" )
			VAR _w2 = 148 * MAX ( MIN ( _r2 / 1.2, 1 ), 0.02 )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 352 200'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='352' height='200'><feGaussianBlur stdDeviation='6'/></filter></defs>" &
			    "<circle cx='96' cy='116' r='54' fill='none' stroke='#FFFFFF' stroke-opacity='0.07' stroke-width='12'/>" &
			    "<circle cx='96' cy='116' r='54' fill='none' stroke='url(#gO)' stroke-width='14' stroke-linecap='round' opacity='0.55' filter='url(#gl)' transform='rotate(-90 96 116)' stroke-dasharray='" &
			    FORMAT ( _dash, "0.0", "en-US" ) &
			    " 400'/>" &
			    "<circle cx='96' cy='116' r='54' fill='none' stroke='url(#gO)' stroke-width='12' stroke-linecap='round' transform='rotate(-90 96 116)' stroke-dasharray='" &
			    FORMAT ( _dash, "0.0", "en-US" ) &
			    " 400'/>" &
			    "<text x='" &
			    "96" &
			    "' y='" &
			    "121" &
			    "' font-family='Segoe UI' font-size='25' font-weight='600' text-anchor='middle' letter-spacing='-0.4' fill='" &
			    "#F3F5FA" &
			    "'>" &
			    FORMAT ( _att, "0.0%", "en-US" ) &
			    "</text>" &
			    "<text x='" &
			    "96" &
			    "' y='" &
			    "138" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='middle'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "EBITDA vs budget" &
			    "</text>" &
			    "<text x='" &
			    "190" &
			    "' y='" &
			    "62" &
			    "' font-family='Segoe UI' font-size='10' font-weight='400' text-anchor='start'  fill='" &
			    "#C9D0DE" &
			    "'>" &
			    "Revenue" &
			    "</text>" &
			    "<text x='" &
			    "338" &
			    "' y='" &
			    "62" &
			    "' font-family='Segoe UI' font-size='10.5' font-weight='600' text-anchor='end'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    FORMAT ( _r0, "0.0%", "en-US" ) &
			    "</text>" &
			    "<rect x='190' y='70' width='148' height='5' rx='2.5' fill='#FFFFFF' fill-opacity='0.08'/>" &
			    "<rect x='190' y='70' width='" &
			    FORMAT ( _w0, "0.0", "en-US" ) &
			    "' height='5' rx='2.5' fill='" &
			    _c0 &
			    "'/>" &
			    "<rect x='312.6' y='67' width='1.5' height='11' rx='0.75' fill='#FFFFFF' fill-opacity='0.55'/>" &
			    "<text x='" &
			    "190" &
			    "' y='" &
			    "87" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#5F6880" &
			    "'>" &
			    IF ( ABS ( [Revenue] ) >= 1000000, FORMAT ( [Revenue] / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( [Revenue] / 1000, "$0", "en-US" ) & "K" ) &
			    " of " &
			    IF ( ABS ( [Revenue Budget] ) >= 1000000, FORMAT ( [Revenue Budget] / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( [Revenue Budget] / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "190" &
			    "' y='" &
			    "104" &
			    "' font-family='Segoe UI' font-size='10' font-weight='400' text-anchor='start'  fill='" &
			    "#C9D0DE" &
			    "'>" &
			    "Gross profit" &
			    "</text>" &
			    "<text x='" &
			    "338" &
			    "' y='" &
			    "104" &
			    "' font-family='Segoe UI' font-size='10.5' font-weight='600' text-anchor='end'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    FORMAT ( _r1, "0.0%", "en-US" ) &
			    "</text>" &
			    "<rect x='190' y='112' width='148' height='5' rx='2.5' fill='#FFFFFF' fill-opacity='0.08'/>" &
			    "<rect x='190' y='112' width='" &
			    FORMAT ( _w1, "0.0", "en-US" ) &
			    "' height='5' rx='2.5' fill='" &
			    _c1 &
			    "'/>" &
			    "<rect x='312.6' y='109' width='1.5' height='11' rx='0.75' fill='#FFFFFF' fill-opacity='0.55'/>" &
			    "<text x='" &
			    "190" &
			    "' y='" &
			    "129" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#5F6880" &
			    "'>" &
			    IF ( ABS ( [Gross Profit] ) >= 1000000, FORMAT ( [Gross Profit] / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( [Gross Profit] / 1000, "$0", "en-US" ) & "K" ) &
			    " of " &
			    IF ( ABS ( [Gross Profit Budget] ) >= 1000000, FORMAT ( [Gross Profit Budget] / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( [Gross Profit Budget] / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "190" &
			    "' y='" &
			    "146" &
			    "' font-family='Segoe UI' font-size='10' font-weight='400' text-anchor='start'  fill='" &
			    "#C9D0DE" &
			    "'>" &
			    "Net income" &
			    "</text>" &
			    "<text x='" &
			    "338" &
