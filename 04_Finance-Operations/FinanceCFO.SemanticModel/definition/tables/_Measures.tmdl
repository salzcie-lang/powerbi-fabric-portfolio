			    "receivables" &
			    "</text>" &
			    IF ( ISBLANK ( _x0D ), "", "<path transform='translate(26,169.5)' d='" &
			    _x0A &
			    "' fill='" &
			    _x0C &
			    "'/>" &
			    "<text x='" &
			    "39" &
			    "' y='" &
			    "177" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='600' text-anchor='start'  fill='" &
			    _x0C &
			    "'>" &
			    _x0S &
			    "</text>" ) &
			    "<circle cx='148' cy='98' r='28' fill='none' stroke='#FFFFFF' stroke-opacity='0.07' stroke-width='7'/>" &
			    "<circle cx='148' cy='98' r='28' fill='none' stroke='#9B7BFF' stroke-width='8' stroke-linecap='round' opacity='0.5' filter='url(#gl)' transform='rotate(-90 148 98)' stroke-dasharray='" &
			    FORMAT ( _d1, "0.0", "en-US" ) &
			    " 200'/>" &
			    "<circle cx='148' cy='98' r='28' fill='none' stroke='#9B7BFF' stroke-width='7' stroke-linecap='round' transform='rotate(-90 148 98)' stroke-dasharray='" &
