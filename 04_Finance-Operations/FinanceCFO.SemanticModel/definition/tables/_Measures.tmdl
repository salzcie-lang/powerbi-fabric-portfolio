	measure 'Var vs Budget' =
			VAR _a = [PnL Value]
			VAR _b = [PnL Budget]
			VAR _ratio = SELECTEDVALUE ( 'PnL Lines'[Line Type] ) = "ratio"
			RETURN
			    IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _b ), IF ( _ratio, FORMAT ( ( _a - _b ) * 100, "+0.0;-0.0" ) & " pts", FORMAT ( ( _a - _b ) / 1000, "+#,##0;-#,##0" ) ) )
		displayFolder: 6. Statement
