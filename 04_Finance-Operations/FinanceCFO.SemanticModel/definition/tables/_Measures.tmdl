	measure 'Invoices 90+' =
			VAR _pe = [Period End]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Receivables ),
			        REMOVEFILTERS ( 'Date' ),
			        FILTER (
			            ALL ( Receivables[Invoice Date], Receivables[Paid Date], Receivables[Due Date] ),
			            Receivables[Invoice Date] <= _pe && ( ISBLANK ( Receivables[Paid Date] ) || Receivables[Paid Date] > _pe )
			                && _pe - Receivables[Due Date] > 90
			        )
			    )
		formatString: #,##0
		displayFolder: 4. Working capital
		lineageTag: 3d43aab8-1064-56cb-a7be-b85e4796b689

	/// Open receivables past their due date.
	measure 'AR Overdue' = [AR Balance] - [AR Current]
		formatString: $#,##0
		displayFolder: 4. Working capital
		lineageTag: 50a8d7c2-56d2-542b-a9ce-5e3619076962

	measure 'Days Overdue Color' = SWITCH ( TRUE (), [Oldest Days Overdue] > 90, "#FF6B7A", [Oldest Days Overdue] > 30, "#FFB86B", "#C9D0DE" )
		displayFolder: 9. Formatting
		lineageTag: 5e3f44b1-cd77-5896-aee7-065e0c33253c

	measure 'AR Overdue %' = DIVIDE ( [AR Balance] - [AR Current], [AR Balance] )
		formatString: 0.0%
		displayFolder: 4. Working capital
		lineageTag: 75d9830e-9e75-5637-9113-0c308c902672

	measure 'GL Amount PY' =
			VAR _Last = [As Of Date]
			RETURN
			    CALCULATE (
			        [GL Amount],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: $#,##0
		displayFolder: 5. Prior year
		lineageTag: ef3e9074-3ead-5316-9a2f-5e6b09795acf

