			    "' font-family='Segoe UI' font-size='10.5' font-weight='600' text-anchor='end'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    FORMAT ( _r2, "0.0%", "en-US" ) &
			    "</text>" &
			    "<rect x='190' y='154' width='148' height='5' rx='2.5' fill='#FFFFFF' fill-opacity='0.08'/>" &
			    "<rect x='190' y='154' width='" &
			    FORMAT ( _w2, "0.0", "en-US" ) &
			    "' height='5' rx='2.5' fill='" &
			    _c2 &
			    "'/>" &
			    "<rect x='312.6' y='151' width='1.5' height='11' rx='0.75' fill='#FFFFFF' fill-opacity='0.55'/>" &
