	measure 'PnL Value' =
			VAR _o = SELECTEDVALUE ( 'PnL Lines'[Line Order] )
			VAR _acc = SELECTEDVALUE ( 'PnL Lines'[AccountCode] )
			RETURN
			    SWITCH (
			        TRUE (),
			        _o = 1, [Revenue],
			        _o = 5, [COGS],
			        _o = 6, [Gross Profit],
			        _o = 7, [Gross Margin],
			        _o = 8, [OpEx],
			        _o = 15, [EBITDA],
			        _o = 16, [EBITDA Margin],
			        _o = 20, [Net Income],
			        _o = 21, [Net Margin],
			        _acc > 0, CALCULATE ( [GL Amount], Accounts[AccountCode] = _acc )
			    )
		formatString: #,##0
		displayFolder: 6. Statement
		lineageTag: c4daeab8-2ed0-5084-a718-a1df3a0ea094

