			RETURN
			    IF (
			        NOT ISBLANK ( _v ),
			        IF ( SELECTEDVALUE ( 'PnL Lines'[Line Type] ) = "ratio", FORMAT ( _v, "0.0%" ), FORMAT ( _v / 1000, "#,##0" ) )
			    )
