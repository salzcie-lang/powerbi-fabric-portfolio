	/// Open receivables at period end, split by days past due.
	measure 'SVG AR Aging' =
			VAR _ar = [AR Balance]
			VAR _od = [AR Overdue %]
			VAR _n90 = [Invoices 90+]
			VAR _a0 = [AR Current] + 0
			VAR _w0 = MAX ( 316 * DIVIDE ( _a0, _ar ), 4 )
			VAR _x0 = 18
			VAR _a1 = [AR 1-30] + 0
			VAR _w1 = MAX ( 316 * DIVIDE ( _a1, _ar ), 4 )
			VAR _x1 = _x0 + _w0 + 4
			VAR _a2 = [AR 31-60] + 0
			VAR _w2 = MAX ( 316 * DIVIDE ( _a2, _ar ), 4 )
			VAR _x2 = _x1 + _w1 + 4
			VAR _a3 = [AR 61-90] + 0
			VAR _w3 = MAX ( 316 * DIVIDE ( _a3, _ar ), 4 )
			VAR _x3 = _x2 + _w2 + 4
			VAR _a4 = [AR 90+] + 0
			VAR _w4 = MAX ( 316 * DIVIDE ( _a4, _ar ), 4 )
			VAR _x4 = _x3 + _w3 + 4
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 368 198'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='368' height='198'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<text x='" &
			    "18" &
			    "' y='" &
			    "76" &
			    "' font-family='Segoe UI' font-size='25' font-weight='600' text-anchor='start' letter-spacing='-0.4' fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _ar ) >= 1000000, FORMAT ( _ar / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _ar / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "350" &
			    "' y='" &
			    "64" &
			    "' font-family='Segoe UI' font-size='15' font-weight='600' text-anchor='end'  fill='" &
			    "#FF6B7A" &
			    "'>" &
			    FORMAT ( _od, "0.0%", "en-US" ) &
			    "</text>" &
			    "<text x='" &
			    "350" &
			    "' y='" &
			    "77" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='end'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "overdue" &
			    "</text>" &
			    "<rect x='" &
			    FORMAT ( _x0, "0.0", "en-US" ) &
			    "' y='92' width='" &
			    FORMAT ( _w0, "0.0", "en-US" ) &
			    "' height='14' rx='5' fill='#4C8DFF'/>" &
			    "<circle cx='22' cy='125' r='3.5' fill='#4C8DFF'/>" &
			    "<text x='" &
			    "30" &
			    "' y='" &
			    "128" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "Current" &
			    "</text>" &
			    "<text x='" &
			    "18" &
			    "' y='" &
			    "147" &
			    "' font-family='Segoe UI' font-size='12' font-weight='600' text-anchor='start'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _a0 ) >= 1000000, FORMAT ( _a0 / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _a0 / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "18" &
			    "' y='" &
			    "160" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#5F6880" &
			    "'>" &
			    FORMAT ( DIVIDE ( _a0, _ar ), "0.0%", "en-US" ) &
			    "</text>" &
			    "<rect x='" &
			    FORMAT ( _x1, "0.0", "en-US" ) &
			    "' y='92' width='" &
			    FORMAT ( _w1, "0.0", "en-US" ) &
			    "' height='14' rx='5' fill='#7AB0FF'/>" &
			    "<circle cx='90' cy='125' r='3.5' fill='#7AB0FF'/>" &
			    "<text x='" &
			    "98" &
			    "' y='" &
			    "128" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "1-30 d" &
			    "</text>" &
			    "<text x='" &
			    "86" &
			    "' y='" &
			    "147" &
			    "' font-family='Segoe UI' font-size='12' font-weight='600' text-anchor='start'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _a1 ) >= 1000000, FORMAT ( _a1 / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _a1 / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "86" &
			    "' y='" &
			    "160" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#5F6880" &
			    "'>" &
			    FORMAT ( DIVIDE ( _a1, _ar ), "0.0%", "en-US" ) &
			    "</text>" &
			    "<rect x='" &
			    FORMAT ( _x2, "0.0", "en-US" ) &
			    "' y='92' width='" &
			    FORMAT ( _w2, "0.0", "en-US" ) &
			    "' height='14' rx='5' fill='#FFD39A'/>" &
			    "<circle cx='158' cy='125' r='3.5' fill='#FFD39A'/>" &
			    "<text x='" &
			    "166" &
			    "' y='" &
			    "128" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "31-60 d" &
			    "</text>" &
			    "<text x='" &
			    "154" &
			    "' y='" &
			    "147" &
			    "' font-family='Segoe UI' font-size='12' font-weight='600' text-anchor='start'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _a2 ) >= 1000000, FORMAT ( _a2 / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _a2 / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "154" &
			    "' y='" &
			    "160" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#5F6880" &
			    "'>" &
			    FORMAT ( DIVIDE ( _a2, _ar ), "0.0%", "en-US" ) &
			    "</text>" &
			    "<rect x='" &
			    FORMAT ( _x3, "0.0", "en-US" ) &
			    "' y='92' width='" &
			    FORMAT ( _w3, "0.0", "en-US" ) &
			    "' height='14' rx='5' fill='#FF8A3D'/>" &
			    "<circle cx='226' cy='125' r='3.5' fill='#FF8A3D'/>" &
			    "<text x='" &
			    "234" &
			    "' y='" &
			    "128" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "61-90 d" &
			    "</text>" &
			    "<text x='" &
			    "222" &
			    "' y='" &
			    "147" &
			    "' font-family='Segoe UI' font-size='12' font-weight='600' text-anchor='start'  fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _a3 ) >= 1000000, FORMAT ( _a3 / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _a3 / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    "<text x='" &
			    "222" &
