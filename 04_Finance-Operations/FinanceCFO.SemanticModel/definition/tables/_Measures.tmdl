	/// Header subtitle that follows the fiscal year selection.
	measure 'SVG Header' =
			VAR _first = CALCULATE ( MIN ( GL[Month] ) )
			VAR _fy = SELECTEDVALUE ( 'Date'[Fiscal Year], "All years" )
			VAR _txt = "Meridian Supply Co.   ·   " & _fy & "   ·   " & FORMAT ( _first, "MMM yyyy", "en-US" ) & " to " & FORMAT ( [Period End], "MMM yyyy", "en-US" ) & "   ·   demo data"
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 520 18'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='520' height='18'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<text x='" &
			    "0" &
			    "' y='" &
			    "13" &
			    "' font-family='Segoe UI' font-size='11.5' font-weight='400' text-anchor='start'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    _txt &
			    "</text>" &
			    "</svg>"
		displayFolder: 7. SVG visuals
		lineageTag: ad36e5c7-fc4d-58a5-a835-fbf0a80d6d4b
		dataCategory: ImageUrl

	/// Headline card. Revenue by default; when a P&L line is clicked in the bridge or OpEx chart it shows that line against prior year and budget.
	measure 'SVG Revenue Hero' =
			VAR _rev = [Focus Value]
			VAR _bud = [Focus Budget]
			VAR _py = [Focus PY]
			VAR _sel = HASONEVALUE ( 'PnL Lines'[Line Order] )
			VAR _cost = _sel && SELECTEDVALUE ( 'PnL Lines'[Line Order] ) IN { 5, 8, 9, 10, 11, 12, 13, 14, 17, 18, 19 }
			VAR _name = IF ( _sel, UPPER ( SUBSTITUTE ( SELECTEDVALUE ( 'PnL Lines'[Line Name] ), "&", "&amp;" ) ), "NET REVENUE" )
			VAR _aD = IF ( NOT ISBLANK ( _py ), DIVIDE ( _rev - _py, ABS ( _py ) ) )
			VAR _aC = IF ( ( _aD >= 0 ) <> _cost, "#5BE3B0", "#FF6B7A" )
			VAR _aS = FORMAT ( ABS ( _aD ), "0.0%", "en-US" ) & " vs PY"
			VAR _aA = IF ( _aD >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" )
			VAR _bD = IF ( NOT ISBLANK ( _bud ), DIVIDE ( _rev - _bud, ABS ( _bud ) ) )
			VAR _bC = IF ( ( _bD >= 0 ) <> _cost, "#5BE3B0", "#FF6B7A" )
			VAR _bS = FORMAT ( ABS ( _bD ), "0.0%", "en-US" ) & " vs budget"
			VAR _bA = IF ( _bD >= 0, "M0 7 L4.5 0 L9 7 Z", "M0 0 L9 0 L4.5 7 Z" )
			VAR _sT = ADDCOLUMNS ( FILTER ( VALUES ( 'Date'[Month Start] ), NOT ISBLANK ( [Focus Value] ) ), "@v0", [Focus Value], "@v1", [Focus Budget] )
			VAR _sN = COUNTROWS ( _sT )
			VAR _sF = MINX ( _sT, 'Date'[Month Start] )
			VAR _sLo = MINX ( _sT, MIN ( [@v0], [@v1] ) )
			VAR _sHi = MAXX ( _sT, MAX ( [@v0], [@v1] ) )
			VAR _sR = IF ( _sHi - _sLo = 0, 1, _sHi - _sLo )
			VAR _sP1 = ADDCOLUMNS ( _sT, "@i", DATEDIFF ( _sF, 'Date'[Month Start], MONTH ) )
			VAR _sP2 = ADDCOLUMNS ( _sP1, "@x", 20 + 380 * DIVIDE ( [@i], _sN - 1, 0.5 ), "@y0", 172 - 50 * DIVIDE ( [@v0] - _sLo, _sR ), "@y1", 172 - 50 * DIVIDE ( [@v1] - _sLo, _sR ) )
			VAR _sQ = ADDCOLUMNS ( _sP2, "@nx", VAR _i = [@i] RETURN MAXX ( FILTER ( _sP2, [@i] = _i + 1 ), [@x] ), "@ny0", VAR _i = [@i] RETURN MAXX ( FILTER ( _sP2, [@i] = _i + 1 ), [@y0] ), "@ny1", VAR _i = [@i] RETURN MAXX ( FILTER ( _sP2, [@i] = _i + 1 ), [@y1] ) )
			VAR _sFX = MAXX ( FILTER ( _sQ, [@i] = 0 ), [@x] )
			VAR _sLX = MAXX ( FILTER ( _sQ, [@i] = _sN - 1 ), [@x] )
			VAR _sFY0 = MAXX ( FILTER ( _sQ, [@i] = 0 ), [@y0] )
			VAR _sLY0 = MAXX ( FILTER ( _sQ, [@i] = _sN - 1 ), [@y0] )
			VAR _sPath0 = "M" & FORMAT ( _sFX, "0.0", "en-US" ) & "," & FORMAT ( _sFY0, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _sQ, NOT ISBLANK ( [@nx] ) ), IF ( [@i] = 0, " L", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y0], "0.0", "en-US" ) & " " ) & FORMAT ( ( [@x] + [@nx] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y0] + [@ny0] ) / 2, "0.0", "en-US" ), "", [@i], ASC ) & " L" & FORMAT ( _sLX, "0.0", "en-US" ) & "," & FORMAT ( _sLY0, "0.0", "en-US" )
			VAR _sFY1 = MAXX ( FILTER ( _sQ, [@i] = 0 ), [@y1] )
			VAR _sLY1 = MAXX ( FILTER ( _sQ, [@i] = _sN - 1 ), [@y1] )
			VAR _sPath1 = "M" & FORMAT ( _sFX, "0.0", "en-US" ) & "," & FORMAT ( _sFY1, "0.0", "en-US" ) & CONCATENATEX ( FILTER ( _sQ, NOT ISBLANK ( [@nx] ) ), IF ( [@i] = 0, " L", " Q" & FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y1], "0.0", "en-US" ) & " " ) & FORMAT ( ( [@x] + [@nx] ) / 2, "0.0", "en-US" ) & "," & FORMAT ( ( [@y1] + [@ny1] ) / 2, "0.0", "en-US" ), "", [@i], ASC ) & " L" & FORMAT ( _sLX, "0.0", "en-US" ) & "," & FORMAT ( _sLY1, "0.0", "en-US" )
			VAR _sArea = _sPath0 & " L" & FORMAT ( _sLX, "0.0", "en-US" ) & ",180 L" & FORMAT ( _sFX, "0.0", "en-US" ) & ",180 Z"
			VAR _months = CONCATENATEX ( _sQ, "<text x='" &
			    FORMAT ( [@x], "0.0", "en-US" ) &
			    "' y='194' font-family='Segoe UI' font-size='8' text-anchor='middle' fill='#5F6880'>" &
			    LEFT ( FORMAT ( 'Date'[Month Start], "MMM", "en-US" ), 1 ) &
			    "</text>", "" )
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 420 200'><defs><linearGradient id='gB' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#4C8DFF'/><stop offset='1' stop-color='#9B7BFF'/></linearGradient><linearGradient id='gBv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#7AB0FF'/><stop offset='1' stop-color='#3D6BF5'/></linearGradient><linearGradient id='gO' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF6A3D'/></linearGradient><linearGradient id='gOv' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#FFB86B'/><stop offset='1' stop-color='#FF7A3D'/></linearGradient><linearGradient id='gG' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#3CC8E0'/><stop offset='1' stop-color='#5BE3B0'/></linearGradient><linearGradient id='gA' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#4C8DFF' stop-opacity='0.38'/><stop offset='1' stop-color='#4C8DFF' stop-opacity='0'/></linearGradient><filter id='gl' filterUnits='userSpaceOnUse' x='0' y='0' width='420' height='200'><feGaussianBlur stdDeviation='5'/></filter></defs>" &
			    "<text x='" &
			    "56" &
			    "' y='" &
			    "34" &
			    "' font-family='Segoe UI' font-size='10' font-weight='600' text-anchor='start' letter-spacing='1.1' fill='" &
			    "#8D96AA" &
			    "'>" &
			    _name &
			    "</text>" &
			    IF ( _sel, "<text x='" &
			    "400" &
			    "' y='" &
			    "34" &
			    "' font-family='Segoe UI' font-size='8.5' font-weight='400' text-anchor='end'  fill='" &
			    "#7AB0FF" &
			    "'>" &
			    "selected line" &
			    "</text>", "" ) &
			    "<text x='" &
			    "20" &
			    "' y='" &
			    "84" &
			    "' font-family='Segoe UI' font-size='36' font-weight='600' text-anchor='start' letter-spacing='-0.5' fill='" &
			    "#F3F5FA" &
			    "'>" &
			    IF ( ABS ( _rev ) >= 1000000, FORMAT ( _rev / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _rev / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    IF ( ISBLANK ( _aD ), "", "<g transform='translate(20,94)'><rect width='104' height='20' rx='10' fill='" &
			    _aC &
			    "' fill-opacity='0.13'/>" &
			    "<path transform='translate(9,6.5)' d='" &
			    _aA &
			    "' fill='" &
			    _aC &
			    "'/>" &
			    "<text x='" &
			    "23" &
			    "' y='" &
			    "14" &
			    "' font-family='Segoe UI' font-size='10' font-weight='600' text-anchor='start'  fill='" &
			    _aC &
			    "'>" &
			    _aS &
			    "</text>" &
			    "</g>" ) &
			    IF ( ISBLANK ( _bD ), "", "<g transform='translate(132,94)'><rect width='128' height='20' rx='10' fill='" &
			    _bC &
			    "' fill-opacity='0.13'/>" &
			    "<path transform='translate(9,6.5)' d='" &
			    _bA &
			    "' fill='" &
			    _bC &
			    "'/>" &
			    "<text x='" &
			    "23" &
			    "' y='" &
			    "14" &
			    "' font-family='Segoe UI' font-size='10' font-weight='600' text-anchor='start'  fill='" &
			    _bC &
			    "'>" &
			    _bS &
			    "</text>" &
			    "</g>" ) &
			    "<text x='" &
			    "400" &
			    "' y='" &
			    "62" &
			    "' font-family='Segoe UI' font-size='10' font-weight='400' text-anchor='end'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "Budget  " &
			    IF ( ABS ( _bud ) >= 1000000, FORMAT ( _bud / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _bud / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" &
			    IF ( ISBLANK ( _py ), "", "<text x='" &
			    "400" &
			    "' y='" &
			    "78" &
			    "' font-family='Segoe UI' font-size='10' font-weight='400' text-anchor='end'  fill='" &
			    "#8D96AA" &
			    "'>" &
			    "Prior year  " &
			    IF ( ABS ( _py ) >= 1000000, FORMAT ( _py / 1000000, "$0.00", "en-US" ) & "M", FORMAT ( _py / 1000, "$0", "en-US" ) & "K" ) &
			    "</text>" ) &
			    "<path d='" &
			    _sArea &
			    "' fill='url(#gA)'/>" &
			    "<path d='" &
			    _sPath1 &
			    "' fill='none' stroke='#8D96AA' stroke-width='1.2' stroke-dasharray='3 4' opacity='0.8'/>" &
			    "<path d='" &
			    _sPath0 &
			    "' fill='none' stroke='url(#gB)' stroke-width='4.6' stroke-linecap='round' opacity='0.6' filter='url(#gl)'/>" &
			    "<path d='" &
			    _sPath0 &
			    "' fill='none' stroke='url(#gB)' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'/>" &
			    "<circle cx='" &
			    FORMAT ( _sLX, "0.0", "en-US" ) &
			    "' cy='" &
			    FORMAT ( _sLY0, "0.0", "en-US" ) &
			    "' r='8' fill='#9B7BFF' opacity='0.28'/>" &
			    "<circle cx='" &
			    FORMAT ( _sLX, "0.0", "en-US" ) &
			    "' cy='" &
			    FORMAT ( _sLY0, "0.0", "en-US" ) &
			    "' r='3.4' fill='#FFFFFF'/>" &
			    _months &
			    "</svg>"
		displayFolder: 7. SVG visuals
		lineageTag: 4f4402eb-2f85-57ae-b1f3-29c961698bea
		dataCategory: ImageUrl

	/// KPI tile for Gross Margin: value, change on prior year and monthly trend.
	measure 'SVG Tile Gross Margin' =
			VAR _cur = [Gross Margin]
			VAR _py = [Gross Margin PY]
			VAR _aD = IF ( NOT ISBLANK ( _py ), ( _cur - _py ) * 100 )
			VAR _aC = IF ( _aD >= 0, "#5BE3B0", "#FF6B7A" )
			VAR _aS = FORMAT ( ABS ( _aD ), "0.0", "en-US" ) & " pts vs PY"
