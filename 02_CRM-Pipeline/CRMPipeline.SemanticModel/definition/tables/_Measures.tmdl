		displayFolder: 9. Formatting
		lineageTag: f47de40d-a694-50f8-9ceb-7b63d5c795c1

	measure 'Open Pipeline Label' = [Open Deals] & " open deals"
		displayFolder: 8. Labels
		lineageTag: d63ce99f-24c5-5e2b-abaa-9e2eca79252b

	measure 'Weighted Pipeline Label' = "expected from open deals"
		displayFolder: 8. Labels
		lineageTag: 19e669b8-6227-53af-afa1-d1d9c3ffe282

	measure 'Open Deals Label' = FORMAT ( [Open Pipeline], "$#,##0" ) & " in pipeline"
		displayFolder: 8. Labels
		lineageTag: c7af883e-181c-5955-9458-4115db9f5154

	measure 'Stalled Deals Label' = "no activity in 21+ days"
		displayFolder: 8. Labels
		lineageTag: c359f5e7-0e19-5e88-bc92-5cdda0e681cf

	measure 'Quota Label' = "of " & FORMAT ( [Quota], "$#,##0" ) & " quota"
		displayFolder: 8. Labels
		lineageTag: 42e113bf-4fd0-5f02-bb34-50c931812b3b

	measure 'Reps at Quota Label' = "of " & COUNTROWS ( Reps ) & " reps at or above quota"
		displayFolder: 8. Labels
		lineageTag: 05403720-04cd-5785-bbb4-dc4b1515621c

	measure 'Won YoY' =
			IF (
			    ISBLANK ( [Won Revenue PY] ) || ISBLANK ( [Won Revenue] ),
			    BLANK (),
			    VAR _d = DIVIDE ( [Won Revenue] - [Won Revenue PY], [Won Revenue PY] )
			    RETURN
			        IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" )
			)
		displayFolder: 8. Labels
		lineageTag: 5331e61a-44bb-5246-89bd-f4f9d4860449

	measure 'Neutral Color' = "#8B95A7"
		displayFolder: 9. Formatting
		lineageTag: 079864c9-ace8-5a37-8512-279f5418beb7

	measure 'Warning Color' = "#FB8FA4"
		displayFolder: 9. Formatting
		lineageTag: aa4c5076-9944-506f-a341-21092b08fd8a

	measure 'Attainment Color' = IF ( [Quota Attainment] >= 1, "#6EE7B7", IF ( [Quota Attainment] >= 0.8, "#D7DCE5", "#FB8FA4" ) )
		displayFolder: 9. Formatting
		lineageTag: ae0bddca-9113-5f41-abd2-35e3dc31c1cd

	measure 'Win Rate Bar Color' =
			VAR _All = CALCULATE ( [Win Rate], ALLSELECTED ( Opportunities[Lead Source] ) )
			RETURN
			    IF ( [Win Rate] < _All, "#3B4654", "#2DD4BF" )
		displayFolder: 9. Formatting
		lineageTag: 06140bc2-b2ff-5a87-a1ee-97d25ebca0b4

	measure 'Stale Color' = IF ( [Days Since Activity] > 21, "#FB8FA4", "#D7DCE5" )
		displayFolder: 9. Formatting
		lineageTag: 0f109454-044d-54d1-8a67-24e38c29a563

	column Placeholder
		dataType: string
		isHidden
		lineageTag: db3abf1d-e323-550b-8bfa-c432b3746259
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = User

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

