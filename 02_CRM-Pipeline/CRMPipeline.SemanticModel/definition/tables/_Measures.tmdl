	measure 'Lead to Win Rate Label' =
			VAR _d = ( [Lead to Win Rate] - [Lead to Win Rate PY] ) * 100
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0" ) & " pts vs PY"
		displayFolder: 8. Labels
