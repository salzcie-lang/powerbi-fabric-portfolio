			RETURN
			    CALCULATE (
			        [Activities],
			        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
			        'Date'[Date] <= EDATE ( _Last, -12 )
			    )
		formatString: #,##0
		displayFolder: 5. Activity
		lineageTag: 9ac35140-37e8-5968-ab74-94c3b1f28259

	measure 'Activities Label' =
			VAR _d = DIVIDE ( [Activities] - [Activities PY], [Activities PY] )
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY"
		displayFolder: 8. Labels
		lineageTag: 2ac41981-47c1-5fed-88bf-6a10815c02a2

	measure 'Activities Color' =
