		formatString: #,##0
		displayFolder: 1. Closed
		lineageTag: 16533678-7485-5448-94aa-72380f29d04e

	measure 'Won Deals Label' =
			VAR _d = DIVIDE ( [Won Deals] - [Won Deals PY], [Won Deals PY] )
			RETURN
			    IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY"
		displayFolder: 8. Labels
